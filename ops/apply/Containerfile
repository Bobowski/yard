FROM alpine:3.22

ARG COMPOSE_VERSION=5.3.1
ARG COMPOSE_SHA256=f9ebc6ebdb19d769b793c245a736caaeb198c62587f13b25c660c13b4987f959
# podman-remote builds through the socket in ~2s; docker-compose build takes ~18s
# on the same socket. install.sh pins the host Podman to the same version.
ARG PODMAN_VERSION=6.1.4
ARG PODMAN_SHA256=af1f85c22214088a0a9986b9c82b4c9b5b74eda8ecaa6c8cca82b1a63f339b4a

# wget downloads the binaries below.
RUN apk add --no-cache ca-certificates wget \
    && wget -q -O /usr/local/bin/docker-compose \
        "https://github.com/docker/compose/releases/download/v${COMPOSE_VERSION}/docker-compose-linux-x86_64" \
    && echo "${COMPOSE_SHA256}  /usr/local/bin/docker-compose" | sha256sum -c \
    && chmod 755 /usr/local/bin/docker-compose \
    && wget -q -O /tmp/podman-remote.tar.gz \
        "https://github.com/containers/podman/releases/download/v${PODMAN_VERSION}/podman-remote-static-linux_amd64.tar.gz" \
    && echo "${PODMAN_SHA256}  /tmp/podman-remote.tar.gz" | sha256sum -c \
    && tar -xzf /tmp/podman-remote.tar.gz -C /usr/local/bin --strip-components=1 \
    && mv /usr/local/bin/podman-remote-static-linux_amd64 /usr/local/bin/podman-remote \
    && rm /tmp/podman-remote.tar.gz

ENV DOCKER_HOST=unix:///run/podman/podman.sock
ENV CONTAINER_HOST=unix:///run/podman/podman.sock

COPY apply.sh /usr/local/bin/apply
RUN chmod 755 /usr/local/bin/apply
COPY default.compose.yml /usr/local/share/yard/default.compose.yml

ENTRYPOINT ["/usr/local/bin/apply"]
